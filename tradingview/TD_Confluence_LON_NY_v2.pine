        alert(f_json(evt4 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom4, imp4, pre4, stp4, tpA4, tpB4, ltA4, ltB4, rsk4), alert.freq_once_per_bar)
    if emitirTrigger and (sen4 == 1 or sen4 == -1)
        alert(f_json(sen4 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom4, imp4, pre4, stp4, tpA4, tpB4, ltA4, ltB4, rsk4), alert.freq_once_per_bar)
    if emitirCancels and sen4 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom4), alert.freq_once_per_bar)

if scan5 and nom5 != syminfo.ticker
