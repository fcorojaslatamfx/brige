if scan14 and nom14 != syminfo.ticker
    if emitirSetups and evt14 != 0
        alert(f_json(evt14 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom14, imp14, pre14, stp14, tpA14, tpB14, ltA14, ltB14, rsk14), alert.freq_once_per_bar)
    if emitirTrigger and (sen14 == 1 or sen14 == -1)
        alert(f_json(sen14 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom14, imp14, pre14, stp14, tpA14, tpB14, ltA14, ltB14, rsk14), alert.freq_once_per_bar)
    if emitirCancels and sen14 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom14), alert.freq_once_per_bar)

// ── Alertas del símbolo del gráfico ──
var string logHistorial = "ESPERANDO CONFLUENCIA"
bool inicioVentana = ventanaPermitida and not ventanaPermitida[1]

if inicioVentana
    logHistorial := "ESPERANDO CONFLUENCIA"
if bloqueoPorCorrelacion and ventanaPermitida
    logHistorial := "BLOQUEO CORRELACIÓN 🛡️"
if soloTFValido and not tfValido
    logHistorial := "TF FUERA DE RANGO 3–15m ⚠️"

// ARMADO — el aviso accionable: la pendiente todavía se puede colocar.
if eventoSetupG != 0
    logHistorial := (eventoSetupG == 2 ? "SETUP LONG ARMADO ◇" : "SETUP SHORT ARMADO ◇") + " " + f_grade(impAtrG)
    if emitirSetups
        alert(f_json(eventoSetupG == 2 ? "SETUP_BUY" : "SETUP_SELL", syminfo.ticker, impAtrG, nivelEntrada, nivelSL, nivelTP1, nivelTP2, loteTP1, loteTP2, riesgoG), alert.freq_once_per_bar)

if senalG == 1
    logHistorial := "BUY DISPARADO 📈 (#" + str.tostring(tradesHoyG) + " hoy)"
    if emitirTrigger
        alert(f_json("BUY_DUAL", syminfo.ticker, impAtrG, nivelEntrada, nivelSL, nivelTP1, nivelTP2, loteTP1, loteTP2, riesgoG), alert.freq_once_per_bar)
    if mostrarMarcas
        label.new(bar_index, low, "BUY LIMIT\n" + str.tostring(nivelEntrada, format.mintick), style=label.style_label_up, color=color.new(#00c853, 0), textcolor=color.white, size=size.small)

if senalG == -1
    logHistorial := "SELL DISPARADO 📉 (#" + str.tostring(tradesHoyG) + " hoy)"
    if emitirTrigger
        alert(f_json("SELL_DUAL", syminfo.ticker, impAtrG, nivelEntrada, nivelSL, nivelTP1, nivelTP2, loteTP1, loteTP2, riesgoG), alert.freq_once_per_bar)
    if mostrarMarcas
        label.new(bar_index, high, "SELL LIMIT\n" + str.tostring(nivelEntrada, format.mintick), style=label.style_label_down, color=color.new(#d50000, 0), textcolor=color.white, size=size.small)

if senalG == 2
    logHistorial := "SETUP RETIRADO POR TIEMPO ⏳"
    if emitirCancels
        alert(f_jsonCancel("SETUP_CANCEL", syminfo.ticker), alert.freq_once_per_bar)

// ==========================================
// 8. VISUALIZACIÓN EN GRÁFICO
// ==========================================
bool tdDemandPlot = low[2] < low[1] and low[2] < low[3] and low[2] < low and low[2] < low[4]
bool tdSupplyPlot = high[2] > high[1] and high[2] > high[3] and high[2] > high and high[2] > high[4]

plotshape(tdDemandPlot, title="TD Demand Point", style=shape.triangleup, location=location.belowbar, color=color.new(#00ffcc, 30), size=size.tiny, offset=-2)
plotshape(tdSupplyPlot, title="TD Supply Point", style=shape.triangledown, location=location.abovebar, color=color.new(#ff5252, 30), size=size.tiny, offset=-2)

bool setupActivo = (estadoG == 2 or estadoG == -2) and not na(nivelEntrada)

var line  lnEntrada = na
var line  lnSL      = na
var line  lnTP1     = na
var line  lnTP2     = na
var label lbEntrada = na
var label lbSL      = na
var label lbTP1     = na
var label lbTP2     = na
var box   bxRiesgo  = na
var box   bxProfit  = na

if barstate.islast
    line.delete(lnEntrada)
    line.delete(lnSL)
    line.delete(lnTP1)
    line.delete(lnTP2)
    label.delete(lbEntrada)
    label.delete(lbSL)
    label.delete(lbTP1)
    label.delete(lbTP2)
    box.delete(bxRiesgo)
    box.delete(bxProfit)
    if setupActivo
        int x1 = bar_index - 12
        int x2 = bar_index + 6
        if mostrarZonas
            bxRiesgo := box.new(x1, math.max(nivelEntrada, nivelSL), x2, math.min(nivelEntrada, nivelSL), border_color=color.new(#ff5252, 70), bgcolor=color.new(#ff5252, 88))
            bxProfit := box.new(x1, math.max(nivelEntrada, nivelTP2), x2, math.min(nivelEntrada, nivelTP2), border_color=color.new(#00e676, 70), bgcolor=color.new(#00e676, 90))
        lnEntrada := line.new(x1, nivelEntrada, x2, nivelEntrada, color=#00ffcc, style=line.style_dashed, width=2)
        lnSL      := line.new(x1, nivelSL, x2, nivelSL, color=#ff5252, style=line.style_solid, width=2)
        lnTP1     := line.new(x1, nivelTP1, x2, nivelTP1, color=#69f0ae, style=line.style_dotted, width=1)
        lnTP2     := line.new(x1, nivelTP2, x2, nivelTP2, color=#00e676, style=line.style_dotted, width=1)
        lbEntrada := label.new(x2, nivelEntrada, "ENTRADA " + str.tostring(nivelEntrada, format.mintick), style=label.style_label_left, color=color.new(#00ffcc, 80), textcolor=#00ffcc, size=size.small)
        lbSL      := label.new(x2, nivelSL, "SL " + str.tostring(nivelSL, format.mintick), style=label.style_label_left, color=color.new(#ff5252, 80), textcolor=#ff5252, size=size.small)
        lbTP1     := label.new(x2, nivelTP1, "TP1 (60%) " + str.tostring(nivelTP1, format.mintick), style=label.style_label_left, color=color.new(#69f0ae, 80), textcolor=#69f0ae, size=size.small)
        lbTP2     := label.new(x2, nivelTP2, "TP2 (40%) " + str.tostring(nivelTP2, format.mintick), style=label.style_label_left, color=color.new(#00e676, 80), textcolor=#00e676, size=size.small)

bgcolor(visLon ? color.new(#2962ff, 92) : na, title="Sesión Londres")
bgcolor(visNY ? color.new(#aa00ff, 92) : na, title="Sesión Nueva York")

// ==========================================
// 9. DASHBOARD PREMIUM + WATCHLIST LIVE
//
//  Los mismos hexes que usa el panel del EA de MT4 (mt4/PessaroBridgeEA_v2.mq4,
//  input InpTema). Si se toca un color aquí, hay que tocarlo allá: el trader ve
//  las dos pantallas a la vez y una diferencia de tono se lee como "no es el
//  mismo sistema".
// ==========================================
bool esDorado = themeColor == "Dorado Elite"
bool esCyber  = themeColor == "Oscuro / Cyberpunk"

color bgHeader  = esDorado ? color.new(#1a1400, 0)  : esCyber ? color.new(#0d1117, 0)  : color.new(#081426, 0)
color bgSub     = esDorado ? color.new(#26200a, 5)  : esCyber ? color.new(#151924, 5)  : color.new(#0a192f, 5)
color bgRowEven = esDorado ? color.new(#211b08, 10) : esCyber ? color.new(#1e222d, 10) : color.new(#122a45, 10)
color bgRowOdd  = esDorado ? color.new(#2b2410, 10) : esCyber ? color.new(#262b38, 10) : color.new(#183a5c, 10)
color txtAccent = esDorado ? #ffd700 : esCyber ? #00ffcc : #64ffda
color txtMuted  = color.new(color.white, 30)
color cVerde    = #00e676
color cRojo     = #ff5252
color cNeutro   = color.new(color.white, 55)

f_txtScan(int e) =>
    e ==  3 ? "🚀 BUY DISPARADO" : e == -3 ? "🔻 SELL DISPARADO" : e == 4 ? "✅ MÁX. TRADES HOY" : e ==  2 ? "🟢 SETUP LONG" : e == -2 ? "🔴 SETUP SHORT" : e ==  1 ? "⏫ Impulso alcista" : e == -1 ? "⏬ Impulso bajista" : "· · ·"

f_colScan(int e) =>
    e >= 2 and e != 4 ? cVerde : e <= -2 ? cRojo : e == 4 ? txtAccent : e == 1 ? color.new(cVerde, 40) : e == -1 ? color.new(cRojo, 40) : cNeutro

var table dash = table.new(dashPos == "Superior Derecha" ? position.top_right : dashPos == "Superior Izquierda" ? position.top_left : dashPos == "Inferior Derecha" ? position.bottom_right : position.bottom_left, 2, 28, border_width=1, border_color=color.new(color.black, 70), frame_width=2, frame_color=color.new(txtAccent, 55))

f_filaScan(int fila, bool activo, string symFull, int est) =>
    color bgc = fila % 2 == 0 ? bgRowEven : bgRowOdd
    table.cell(dash, 0, fila, f_nombreCorto(symFull), bgcolor=bgc, text_color=activo ? color.white : txtMuted, text_size=size.tiny)
    table.cell(dash, 1, fila, activo ? f_txtScan(est) : "— slot off", bgcolor=bgc, text_color=activo ? f_colScan(est) : txtMuted, text_size=size.tiny)

if barstate.islast
    string txtSesion  = ventanaPermitida ? "🌍 LON→NY · ACTIVA" : "💤 FUERA DE VENTANA"
    string txtTF      = timeframe.period + "m · " + (tfValido ? "ÓPTIMO ✅" : "FUERA DE RANGO ⚠️")
    string txtEstado  = f_txtScan(estadoG)
    string txtImpulso = modoImpulso == "Adaptativo (ATR volatilidad)" ? str.tostring(minImpulso / pipSize, "#.#") + " pips (ATR×" + str.tostring(multiATR * multiPerfil, "#.##") + ")" : str.tostring(minImpulso / pipSize, "#.#") + " pips fijos"
    string txtNiveles = setupActivo ? str.tostring(nivelEntrada, format.mintick) + "  /  " + str.tostring(nivelSL, format.mintick) : "—"
    string txtTPs     = setupActivo ? str.tostring(nivelTP1, format.mintick) + "  /  " + str.tostring(nivelTP2, format.mintick) : "—"
    string txtRR      = setupActivo and not na(rr1) ? "1 : " + str.tostring(rr1, "#.##") + "  ·  1 : " + str.tostring(rr2, "#.##") : "—"
    string txtLotes   = setupActivo ? str.tostring(loteTP1, "#.##") + " + " + str.tostring(loteTP2, "#.##") : "—"
    string txtCalidad = setupActivo ? (f_grade(impAtrG) == "ELITE" ? "★ ELITE" : "STANDARD") + "  ·  " + str.tostring(impAtrG, "#.##") + "×ATR" : "—"

    table.cell(dash, 0, 0, "⚜ TD CONFLUENCE LON→NY", bgcolor=bgHeader, text_color=txtAccent, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + nombrePerfil, bgcolor=bgHeader, text_color=txtAccent, text_size=size.small)
    table.cell(dash, 0, 1, "Timeframe", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 1, txtTF, bgcolor=bgRowOdd, text_color=tfValido ? cVerde : cRojo, text_size=size.tiny)
    table.cell(dash, 0, 2, "Impulso mín.", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 2, txtImpulso, bgcolor=bgRowEven, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 3, "Sesión", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 3, txtSesion, bgcolor=bgRowOdd, text_color=ventanaPermitida ? cVerde : cNeutro, text_size=size.tiny)
    table.cell(dash, 0, 4, "Estado Motor", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 4, txtEstado, bgcolor=bgRowEven, text_color=f_colScan(estadoG), text_size=size.tiny)
    table.cell(dash, 0, 5, "Trades hoy", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(tradesHoyG) + " / " + str.tostring(maxTradesDia), bgcolor=bgRowOdd, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 6, "Entrada / SL", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 6, txtNiveles, bgcolor=bgRowEven, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 7, "TP1 / TP2", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 7, txtTPs, bgcolor=bgRowOdd, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 8, "Ratio R:R", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 8, txtRR, bgcolor=bgRowEven, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 9, "Lotes 60/40", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 9, txtLotes, bgcolor=bgRowOdd, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 10, "Calidad", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 10, txtCalidad, bgcolor=bgRowEven, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 11, "Riesgo", bgcolor=bgRowOdd, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 11, "$" + str.tostring(riesgoG, "#.##") + "  (" + str.tostring(pctRiesgo * 100, "#.##") + "%)", bgcolor=bgRowOdd, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 0, 12, "Log", bgcolor=bgRowEven, text_color=txtMuted, text_size=size.tiny)
    table.cell(dash, 1, 12, logHistorial, bgcolor=bgRowEven, text_color=txtAccent, text_size=size.tiny)

    table.cell(dash, 0, 13, "📡 WATCHLIST LIVE", bgcolor=bgSub, text_color=txtAccent, text_size=size.tiny)
    table.cell(dash, 1, 13, "Webhooks v2.0 · TF " + timeframe.period + "m", bgcolor=bgSub, text_color=txtMuted, text_size=size.tiny)

    f_filaScan(14, scan1,  sym1,  est1)
    f_filaScan(15, scan2,  sym2,  est2)
    f_filaScan(16, scan3,  sym3,  est3)
    f_filaScan(17, scan4,  sym4,  est4)
    f_filaScan(18, scan5,  sym5,  est5)
    f_filaScan(19, scan6,  sym6,  est6)
    f_filaScan(20, scan7,  sym7,  est7)
    f_filaScan(21, scan8,  sym8,  est8)
    f_filaScan(22, scan9,  sym9,  est9)
    f_filaScan(23, scan10, sym10, est10)
    f_filaScan(24, scan11, sym11, est11)
    f_filaScan(25, scan12, sym12, est12)
    f_filaScan(26, scan13, sym13, est13)
    f_filaScan(27, scan14, sym14, est14)
