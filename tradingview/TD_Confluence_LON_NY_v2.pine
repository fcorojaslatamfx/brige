        alert(f_json(evt11 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom11, imp11, pre11, stp11, tpA11, tpB11, ltA11, ltB11, rsk11), alert.freq_once_per_bar)
    if emitirTrigger and (sen11 == 1 or sen11 == -1)
        alert(f_json(sen11 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom11, imp11, pre11, stp11, tpA11, tpB11, ltA11, ltB11, rsk11), alert.freq_once_per_bar)
    if emitirCancels and sen11 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom11), alert.freq_once_per_bar)

if scan12 and nom12 != syminfo.ticker
    if emitirSetups and evt12 != 0
        alert(f_json(evt12 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom12, imp12, pre12, stp12, tpA12, tpB12, ltA12, ltB12, rsk12), alert.freq_once_per_bar)
    if emitirTrigger and (sen12 == 1 or sen12 == -1)
        alert(f_json(sen12 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom12, imp12, pre12, stp12, tpA12, tpB12, ltA12, ltB12, rsk12), alert.freq_once_per_bar)
    if emitirCancels and sen12 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom12), alert.freq_once_per_bar)

if scan13 and nom13 != syminfo.ticker
    if emitirSetups and evt13 != 0
        alert(f_json(evt13 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom13, imp13, pre13, stp13, tpA13, tpB13, ltA13, ltB13, rsk13), alert.freq_once_per_bar)
    if emitirTrigger and (sen13 == 1 or sen13 == -1)
        alert(f_json(sen13 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom13, imp13, pre13, stp13, tpA13, tpB13, ltA13, ltB13, rsk13), alert.freq_once_per_bar)
    if emitirCancels and sen13 == 2
