    if emitirTrigger and (sen10 == 1 or sen10 == -1)
        alert(f_json(sen10 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom10, imp10, pre10, stp10, tpA10, tpB10, ltA10, ltB10, rsk10), alert.freq_once_per_bar)
    if emitirCancels and sen10 == 2
