    if emitirTrigger and (sen6 == 1 or sen6 == -1)
        alert(f_json(sen6 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom6, imp6, pre6, stp6, tpA6, tpB6, ltA6, ltB6, rsk6), alert.freq_once_per_bar)
    if emitirCancels and sen6 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom6), alert.freq_once_per_bar)

if scan7 and nom7 != syminfo.ticker
    if emitirSetups and evt7 != 0
        alert(f_json(evt7 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom7, imp7, pre7, stp7, tpA7, tpB7, ltA7, ltB7, rsk7), alert.freq_once_per_bar)
    if emitirTrigger and (sen7 == 1 or sen7 == -1)
        alert(f_json(sen7 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom7, imp7, pre7, stp7, tpA7, tpB7, ltA7, ltB7, rsk7), alert.freq_once_per_bar)
    if emitirCancels and sen7 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom7), alert.freq_once_per_bar)

if scan8 and nom8 != syminfo.ticker
    if emitirSetups and evt8 != 0
        alert(f_json(evt8 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom8, imp8, pre8, stp8, tpA8, tpB8, ltA8, ltB8, rsk8), alert.freq_once_per_bar)
    if emitirTrigger and (sen8 == 1 or sen8 == -1)
        alert(f_json(sen8 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom8, imp8, pre8, stp8, tpA8, tpB8, ltA8, ltB8, rsk8), alert.freq_once_per_bar)
    if emitirCancels and sen8 == 2
        alert(f_jsonCancel("SETUP_CANCEL", nom8), alert.freq_once_per_bar)

if scan9 and nom9 != syminfo.ticker
    if emitirSetups and evt9 != 0
        alert(f_json(evt9 == 2 ? "SETUP_BUY" : "SETUP_SELL", nom9, imp9, pre9, stp9, tpA9, tpB9, ltA9, ltB9, rsk9), alert.freq_once_per_bar)
    if emitirTrigger and (sen9 == 1 or sen9 == -1)
        alert(f_json(sen9 == 1 ? "BUY_DUAL" : "SELL_DUAL", nom9, imp9, pre9, stp9, tpA9, tpB9, ltA9, ltB9, rsk9), alert.freq_once_per_bar)
    if emitirCancels and sen9 == 2
