# Supabase (server, service-role — nunca exponer al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Supabase Auth (browser, anon key pública — segura de exponer, RLS deniega
# todo a anon/authenticated, solo sirve para el intercambio de sesión)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tokens de acceso (32+ caracteres, generar con `openssl rand -hex 32`).
# La fuente de verdad en runtime es la tabla `tokens` (gestionada desde
# /status/tokens); estas env vars solo se usan para el backfill inicial
# (scripts/backfill-tokens.ts) y para bootstrap de tests locales.
TV_WEBHOOK_TOKEN=
EA_TOKEN=
OPERATOR_TOKEN=
CRON_SECRET=

# Solo para el setup inicial (scripts/create-admin-user.ts), no se usan en runtime
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Resend (envío de email de invitación, ver app/api/users/invite y lib/email.ts)
RESEND_API_KEY=

# Base URL pública de la app, usada para armar el link de "configurar
# contraseña" del email de invitación (generateLink redirectTo). Si se
# omite, cae a https://brige.pessaro.cl — en local conviene setear
# http://localhost:3000 para que el link apunte al dev server.
APP_URL=
