# Supabase (server, service-role — nunca exponer al navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Supabase Auth (browser, anon key pública — segura de exponer, RLS deniega
# todo a anon/authenticated, solo sirve para el intercambio de sesión)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tokens de acceso (32+ caracteres, generar con `openssl rand -hex 32`).
# La fuente de verdad en runtime es la tabla `tokens` (gestionada desde
# /status/tokens); estas env vars solo se usan para el backfill inicial
# (scripts/backfill-tokens.ts) y para bootstrap de tests locales.
TV_WEBHOOK_TOKEN=
EA_TOKEN=
OPERATOR_TOKEN=
CRON_SECRET=

# Solo para el setup inicial (scripts/create-admin-user.ts), no se usan en runtime
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
